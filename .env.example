# Database — local dev uses Dockerized Postgres 16 (NOT SQLite; the schema datasource is postgresql).
#   docker compose up -d postgres        # host port 5434 (see docker-compose.yml)
#   npm run db:push && npm run db:seed    # create schema + seed the local DB
# Production / SELECT-only prod inventory uses the self-hosted Postgres via SSH tunnel — never seed it.
DATABASE_URL="postgresql://intera:intera@localhost:5434/intera"

# ── Auth (Console login) ──
# Generate with: openssl rand -hex 32  (Console will refuse to issue sessions without this)
SESSION_SECRET="generate-with-openssl-rand-hex-32-min-16-chars"
# Staff login password (the value you type at /login → "Staff")
STAFF_PASSWORD="your-staff-password"
# Default org's customer password (used by `default` org row if you set Organization.password)
API_ORG_PASSWORD="your-default-org-customer-password"

# ── LLM ──
# MiniMax — Anthropic-compatible endpoint (default)
ANTHROPIC_AUTH_TOKEN="your-minimax-api-key"
ANTHROPIC_BASE_URL="https://api.minimaxi.com/anthropic"
ANTHROPIC_MODEL="MiniMax-M2.7-highspeed"
MINIMAX_API_KEY="your-minimax-api-key"
MINIMAX_BASE_URL="https://api.minimaxi.com/anthropic"

# DeepSeek — Anthropic-compatible endpoint
DEEPSEEK_API_KEY="your-deepseek-api-key"
DEEPSEEK_BASE_URL="https://api.deepseek.com/anthropic"

# OpenRouter — multi-provider gateway (Anthropic-compatible)
OPENROUTER_API_KEY="your-openrouter-api-key"

# App Config
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_CHAT_API_URL="http://localhost:3000"

# DeepSeek Beta Chat Completions (customer composer assist)
DEEPSEEK_BETA_CHAT_BASE_URL="https://api.deepseek.com/beta"
