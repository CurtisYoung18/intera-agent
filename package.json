{
  "name": "intera-agent",
  "description": "Agent-native control plane for customer-support AI",
  "license": "Apache-2.0",
  "private": true,
  "workspaces": [
    "apps/runtime",
    "apps/console",
    "packages/*"
  ],
  "scripts": {
    "dev:console": "npm run dev -w apps/console",
    "start:runtime": "npm run start -w apps/runtime",
    "test:runtime": "npm run test -w apps/runtime",
    "build:console": "npm run build -w apps/console",
    "agentops:local": "node scripts/agentops-local.mjs",
    "smoke:agentops": "node scripts/agentops-local.mjs smoke",
    "smoke:console": "node scripts/smoke-console-auth.mjs",
    "ci:receipts": "node scripts/ci-receipts.mjs",
    "db:generate": "npm run db:generate -w packages/shared",
    "db:push": "npm run db:push -w packages/shared",
    "db:studio": "npm run db:studio -w packages/shared",
    "db:seed": "npm run db:seed -w packages/shared",
    "check:migration-prefixes": "node scripts/check-migration-prefixes.mjs",
    "check:isolation-seam": "node scripts/check-isolation-seam.mjs",
    "check:runtime-core-boundary": "node scripts/check-runtime-core-boundary.mjs",
    "check:production-readiness": "node scripts/production-readiness-check.mjs",
    "reports:production-chat": "node scripts/generate-production-chat-trace-dashboard.mjs",
    "test": "npm run check:migration-prefixes && npm run check:isolation-seam && npm run check:runtime-core-boundary && npx vitest run",
    "test:watch": "npx vitest",
    "test:coverage": "npx vitest run --coverage"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.7",
    "jsdom": "^29.1.1",
    "playwright": "^1.59.1",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3"
  }
}
