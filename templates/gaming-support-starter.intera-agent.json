      "procedure": {
        "version": "v2",
        "whenToUse": "Use when the customer asks why a withdrawal is pending, rejected, or unavailable.",
        "overview": "Collect withdrawal details, inspect live withdrawal evidence, and explain the safest next step.",
        "steps": [
          {
            "id": "collect_withdrawal_details",
            "title": "Collect withdrawal details",
            "guidance": "Collect member id and withdrawal id if they are missing.",
            "actions": [
              {
