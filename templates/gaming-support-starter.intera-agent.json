{
  "schemaVersion": "intera.agentTemplate.v1",
  "metadata": {
    "templateId": "gaming_support_starter",
    "name": "Gaming Support Starter",
    "industry": "gaming",
    "locales": ["en-US", "zh-CN"],
    "publisher": "Intera",
    "license": "internal-delivery",
    "marketplace": {
      "category": "customer-support",
      "tags": ["gaming", "igaming", "support", "starter"]
    }
  },
  "agent": {
    "name": "Gaming Support Starter",
    "model": "deepseek-v4-flash",
    "temperature": 0.5,
    "thinkingBudget": 4096,
    "maxIterations": 20,
    "maxOutputTokens": 4096,
    "coreSystemPrompt": "You are Intera, a customer service assistant for a gaming support desk. Respond in the customer's language, collect missing facts through Tools, never invent account data, and transfer to a human when evidence conflicts or policy boundaries require it.",
    "memoryStrategy": {
      "enableChatMemory": true,
      "maxRecentTraces": 20
    }
  },
  "caseTypes": [
    {
      "type": "deposit_issue",
      "displayName": "Deposit not credited",
      "description": "Customer says a deposit or top-up was charged but did not appear in their gaming balance.",
      "icon": "money",
      "requiredFacts": ["member_id", "amount", "currency", "payment_method", "approximate_time"],
      "defaultGoal": "Collect deposit details, check platform evidence, and escalate when the payment evidence is conflicting or incomplete.",
      "escalateOn": ["conflict", "missing_payment_provider_status"],
      "enabled": true,
      "maxAutoTurns": 8,
      "procedure": {
        "version": "v2",
        "whenToUse": "Use when a deposit or top-up was charged but did not appear in the customer's balance.",
        "overview": "Collect the deposit details, inspect live platform evidence, and hand off only when the evidence conflicts or requires manual review.",
        "handoffGuidance": "Escalate to payment_ops when platform evidence conflicts with the customer report or a manual provider review is required.",
        "steps": [
          {
            "id": "collect_deposit_details",
            "title": "Collect deposit details",
            "guidance": "Collect member id, amount, currency, payment method, and approximate deposit time.",
            "actions": [
              {
                "id": "ask_deposit_details",
                "kind": "ask",
                "label": "Ask for deposit details",
                "fields": ["member_id", "amount", "currency", "payment_method", "approximate_time"]
              }
            ]
          },
          {
            "id": "lookup_latest_deposit",
            "title": "Check latest deposit evidence",
            "guidance": "Read the latest platform-side deposit record before drawing a conclusion.",
            "actions": [
              {
                "id": "lookup_latest_deposit_action",
                "kind": "call_tool",
                "label": "Check latest deposit",
                "toolName": "get_latest_deposit"
              }
            ],
            "branches": [
              {
                "id": "handoff_if_conflict",
                "kind": "if",
                "condition": {
                  "kind": "llm_eval",
                  "prompt": "Based on the deposit evidence and the customer report, is there a conflict or manual-review need that requires payment_ops handoff?"
                },
                "actions": [
                  {
                    "id": "request_payment_ops_review",
                    "kind": "request_human_handoff",
                    "label": "Request payment ops review",
                    "queue": "payment_ops"
                  }
                ]
              }
            ],
            "completionGuidance": "Do not finalize until the deposit evidence is reconciled or a human handoff is persisted."
          },
          {
            "id": "explain_deposit_next_step",
            "title": "Explain the next step",
            "guidance": "Explain the current status, cite evidence, and avoid promising compensation.",
            "actions": [
              {
                "id": "finish_deposit_case",
                "kind": "end",
                "label": "Finalize deposit answer",
                "status": "completed"
              }
            ]
          }
        ]
      }
    },
    {
      "type": "withdrawal_status",
      "displayName": "Withdrawal status",
      "description": "Customer asks why a withdrawal is pending, rejected, or unavailable.",
      "icon": "withdrawal",
      "requiredFacts": ["member_id", "withdrawal_id"],
      "defaultGoal": "Check withdrawal status and turnover requirements before explaining next steps.",
      "escalateOn": ["conflict", "manual_review"],
      "enabled": true,
      "maxAutoTurns": 8,
      "procedure": {
        "version": "v2",
        "whenToUse": "Use when the customer asks why a withdrawal is pending, rejected, or unavailable.",
        "overview": "Collect withdrawal details, inspect live withdrawal evidence, and explain the safest next step.",
        "steps": [
          {
            "id": "collect_withdrawal_details",
            "title": "Collect withdrawal details",
            "guidance": "Collect member id and withdrawal id if they are missing.",
            "actions": [
              {
                "id": "ask_withdrawal_details",
                "kind": "ask",
                "label": "Ask for withdrawal details",
                "fields": ["member_id", "withdrawal_id"]
              }
            ]
          },
          {
            "id": "lookup_withdrawal_status",
            "title": "Check withdrawal status",
            "guidance": "Check current withdrawal status and turnover requirements.",
            "actions": [
              {
                "id": "lookup_withdrawal_status_action",
                "kind": "call_tool",
                "label": "Check withdrawal status",
                "toolName": "get_withdrawal_status"
              }
            ]
          },
          {
            "id": "explain_withdrawal_next_step",
            "title": "Explain the next step",
            "guidance": "Explain status and next step without making unsupported payout promises.",
            "actions": [
              {
                "id": "finish_withdrawal_case",
                "kind": "end",
                "label": "Finalize withdrawal answer",
                "status": "completed"
              }
            ]
          }
        ]
      }
    }
  ],
