# Concrete Caddyfile for the demo.anytrans.ai deployment.
#
# Uses the MANUALLY-ISSUED wildcard cert (*.anytrans.ai, DigiCert/RapidSSL)
# instead of Caddy's Let's Encrypt auto-TLS — so no port-80 ACME challenge is
# needed. Only inbound 443 (HTTPS + LiveChat webhook) and 80 (HTTP→HTTPS
# redirect) must be reachable.
#
# Install:
#   sudo cp deploy/Caddyfile.demo-anytrans.ai /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# Cert files (copy from the SSL bundle — use the Nginx variant; its .crt is a
# fullchain = leaf + intermediates, which is what Caddy's `tls` wants):
#   /etc/intera/tls/demo.anytrans.ai.crt   ← <bundle>_Nginx/..._server.crt
#   /etc/intera/tls/demo.anytrans.ai.key   ← <bundle>_Nginx/..._server.key  (chmod 600)
#
# Cert expires 2026-07-22 — set a renewal reminder.

demo.anytrans.ai {
    encode gzip

    # Manually-provided cert (NOT auto-TLS)
    tls /etc/intera/tls/demo.anytrans.ai.crt /etc/intera/tls/demo.anytrans.ai.key

    # SSE endpoints: flush immediately, no proxy buffering
    @sse path /api/messages /api/cases/*/stream
    reverse_proxy @sse localhost:3000 {
        flush_interval -1
    }

    reverse_proxy localhost:3000
}
