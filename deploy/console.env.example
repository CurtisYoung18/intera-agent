# ── 运行 ──
NODE_ENV=production
PORT=3000
# Runtime split:
# - INTERA_RUNTIME_URL enables Console /api/messages and LiveChat bridge calls to go through
#   the internal runtime service first.
# - CONSOLE_INTERNAL_URL is used by the runtime service's temporary legacy-forward mode while
#   the turn handler is being moved behind the runtime process.
INTERA_RUNTIME_URL=http://127.0.0.1:3101
CONSOLE_INTERNAL_URL=http://127.0.0.1:3000
# Legacy fallback: bridge 自调用 /api/messages 用此 URL when INTERA_RUNTIME_URL is unset.
INTERNAL_CHAT_API_URL=http://localhost:3000

# ── 鉴权（生产硬依赖）──
# 生成：openssl rand -hex 32
INTERNAL_API_SECRET=<generate-with-openssl-rand-hex-32>
# Console 签名 session 密钥（缺失则无人能登录 Console — fail closed）。生成：openssl rand -hex 32
SESSION_SECRET=<generate-with-openssl-rand-hex-32>
# 内部员工登录 Console 的统一密码（staff 登录后可切换所有 org）
STAFF_PASSWORD=<strong-staff-password>
# 内置 api org 密码（不设则 api org 仅靠 API key）
API_ORG_PASSWORD=<strong-password>

# ── 数据库 ──
DATABASE_URL=postgresql://intera:<db-password>@localhost:5432/intera?schema=public

# ── LLM ──
ANTHROPIC_AUTH_TOKEN=<anthropic-api-key>
ANTHROPIC_BASE_URL=
DEEPSEEK_API_KEY=          # 可选
MINIMAX_API_KEY=           # 可选
OPENROUTER_API_KEY=        # 可选
GPTBOTS_API_KEY=           # 可选，知识库检索

# ── LiveChat ──
LIVECHAT_CLIENT_ID=
LIVECHAT_CLIENT_SECRET=
