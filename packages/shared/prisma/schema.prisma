// Intera Harness - Prisma Schema
// Agentic Customer Service Platform
//
// Table names use explicit @@map for PostgreSQL compatibility.
// Local dev uses a Dockerized Postgres 16 (docker compose up -d postgres → host port 5434);
// production is the self-hosted Ubuntu Postgres. The legacy SQLite dev shim is retired
// (the postgresql datasource cannot use a file: URL). See doc/to-do/2026-06-08-foundation-safe-local-db.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// B 端商户（游戏供应商 / 商户）
// ============================================
model Organization {
  id        String   @id @default(cuid())
  name      String
  apiKey    String?
  password  String? // bcrypt hash — null means no password needed for Console
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  invitations Invitation[]

  @@map("organizations")
}

// ============================================
// API Key — per-org authentication keys
// ============================================
model ApiKey {
  id            String    @id @default(cuid())
  orgId         String    @map("org_id")
  name          String // "production" | "staging" | 渠道名
  prefix        String // 明文前 8 位，便于 UI 识别，如 "intera_sk_live_a1b2"
  hash          String    @unique // sha256(fullKey)
  agentConfigId String?   @map("agent_config_id") // 绑定到具体 AgentConfig；null = org 默认
  lastUsedAt    DateTime? @map("last_used_at")
  revokedAt     DateTime? @map("revoked_at")
  createdAt     DateTime  @default(now())

  @@index([orgId])
  @@index([orgId, agentConfigId])
  @@map("api_keys")
}

// ============================================
// Agent 编排配置
// ============================================
model AgentConfig {
  id    String @id @default(cuid())
  orgId String @map("org_id")
  name  String @default("Default")

  /// Version number — multiple rows per (orgId, name) form a linear version history.
  /// The row where isActive = true is the one runtime traffic uses.
  version  Int     @default(1)
  /// Points to the row this version was forked from. Null for v1 (root).
  parentId String?
  /// Exactly one row per (orgId, name) has isActive = true.
  /// Enforced in app code via atomic transactions on /activate.
  isActive Boolean @default(true)

  parent   AgentConfig?  @relation("AgentVersions", fields: [parentId], references: [id], onDelete: SetNull)
  children AgentConfig[] @relation("AgentVersions")

  // Agent-scoped sub-modules
  tools            Tool[]
  hooks            Hook[]
  caseTypes        CaseType[]
  knowledgeSources KnowledgeSource[]
  channelBindings  ChannelBinding[]

  model            String
  temperature      Float   @default(0.5)
  thinkingBudget   Int     @default(4096)
  maxIterations    Int     @default(20)
  coreSystemPrompt String? // Core/discovery prompt (no active case); falls back to CORE_SYSTEM_PROMPT default when empty
  extendedThinking Boolean @default(false) @map("showThinking")

  maxOutputTokens Int? // default 4096
  resumePrompt    String? // synthetic message for human task resume

  // JSON fields
  memoryStrategy String // MemoryStrategy
  gptbotsApiKey  String? // per-org GPTBots API key (overrides GPTBOTS_API_KEY env var)

  /// Version release note — set when a version is published/activated
  releaseNote String?   @map("release_note")
  /// When this version was published (made active)
  publishedAt DateTime? @map("published_at")
  /// User ID of who published this version
  publishedBy String?   @map("published_by")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, name, version])
  @@index([orgId])
  @@index([orgId, name, isActive])
  @@map("agent_configs")
}

// ============================================
// Case 类型定义（Procedure target）
// ============================================
model CaseType {
  id            String @id @default(cuid())
  agentConfigId String @map("agent_config_id")

  type        String
  displayName String
  description String?
  icon        String

  requiredFacts       String // JSON: string[]
  defaultGoal         String
  escalateOn          String // JSON: string[]
  autoCloseConditions String? // JSON

  enabled Boolean @default(true) // false = excluded from routing / intent classification UI

  /// JSON: Procedure (ordered ProcedureStep[]). When present, the case runs the single-agent Procedure path.
  procedure    String?
  /// Safety bound on auto-continuation turns.
  maxAutoTurns Int     @default(10)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agentConfig AgentConfig @relation(fields: [agentConfigId], references: [id], onDelete: Cascade)

  @@unique([agentConfigId, type])
  @@map("case_types")
}

// ============================================
// Tool 注册中心
// ============================================
model Tool {
  id            String @id @default(cuid())
  agentConfigId String @map("agent_config_id")

  name        String
  description String

  inputSchema  String // JSON Schema
  outputSchema String // JSON Schema

  mode       String  @default("static_fixture")
  endpoint   String?
  httpMethod String  @default("POST")
  headers    String? // JSON
  timeoutMs  Int     @default(8000)

  mockFixture String? // JSON — [MOCK] mock 默认样本
  displayVerb String? // JSON {"text":"...","icon":"..."} — customer-visible spinner label
  renderHints String? // JSON: { livechat?: LivechatRenderHint, "web-chat"?: RenderHint }

  guardPhase        String  @default("post") // "pre" | "post"
  toolCategory      String? // "system_info" | "operational" | null
  isConcurrencySafe Boolean @default(true)
  enabled           Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agentConfig AgentConfig @relation(fields: [agentConfigId], references: [id], onDelete: Cascade)

  @@unique([agentConfigId, name])
  @@map("tools")
}

// ============================================
// Hook control layer
// ============================================
model Hook {
  id            String @id @default(cuid())
  agentConfigId String @map("agent_config_id")

  name        String
  displayName String?
  description String?

  checkpoint  String // PreToolUse | PostToolUse | Stop
  handlerKind String // declarative | code | http
  handler     String // JSON: HookHandler
  enabled     Boolean @default(true)
  severity    String  @default("medium") // low | medium | high | critical

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agentConfig AgentConfig   @relation(fields: [agentConfigId], references: [id], onDelete: Cascade)
  bindings    HookBinding[]

  @@unique([agentConfigId, name])
  @@index([agentConfigId, checkpoint])
  @@map("hooks")
}

model HookBinding {
  id            String @id @default(cuid())
  agentConfigId String @map("agent_config_id")
  hookId        String @map("hook_id")

  scopeType String // agent | caseType | procedureStep | tool
  scopeKey  String // agent | caseType:<id> | procedureStep:<caseTypeId>:<stepId> | tool:<id>

  caseTypeId      String? @map("case_type_id")
  procedureStepId String? @map("procedure_step_id")
  toolId          String? @map("tool_id")

  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hook Hook @relation(fields: [hookId], references: [id], onDelete: Cascade)

  @@unique([agentConfigId, hookId, scopeKey])
  @@index([agentConfigId, scopeType])
  @@index([agentConfigId, scopeKey])
  @@map("hook_bindings")
}

// ============================================
// Case（工单）
// ============================================
model Case {
  id     String @id @default(cuid())
  orgId  String @default("default") @map("org_id")
  userId String
  /// Groups all cases that belong to the same chat session.
  /// Generated once per page-load by the frontend and forwarded with every message.
  chatId String

  type    String
  status  String  @default("created")
  source  String  @default("live")
  goal    String?
  blocker String?
  runtimeInputEpoch Int @default(0)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?

  memory     ChatMemory?
  messages   Message[]
  traces     ActionTrace[]
  humanTasks HumanTask[]

  @@index([chatId])
  @@map("cases")
}

model ProcedureRun {
  id               String   @id
  caseId           String
  orgId            String   @default("default") @map("org_id")
  chatId           String   @default("")
  agentConfigId    String
  procedureId      String
  status           String
  inputEpoch       Int      @default(0)
  needsReconcile   Boolean  @default(false)
  currentStepId    String?
  outcome          String?
  state            Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([caseId, status])
  @@index([orgId, chatId, status])
  @@index([agentConfigId, procedureId, status])
}

// ============================================
// Chat Memory — per-case working memory (facts, tool results, todos, compact summary).
// Cross-session accumulation lives in UserProfile (user_profiles table).
// ============================================
model ChatMemory {
  id     String @id @default(cuid())
  caseId String @unique
  orgId  String @default("default") @map("org_id")
  chatId String @default("")
  runId  String? @map("run_id")
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  contextMap      String  @default("{}") // JSON
  missingFacts    String  @default("[]") // JSON
  toolsCalled     String  @default("[]") // JSON
  toolResults     String  @default("{}") // JSON
  keyEvents       String  @default("[]") // JSON
  humanTaskStatus String  @default("none")
  summary         String?
  /// JSON: TodoItem[] — Procedure todo list for the Case Owner Agent
  todos           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId, chatId])
  @@index([orgId, runId])
  @@map("chat_memories")
}

// ============================================
// User Profile — AI-maintained Markdown user portrait (per agent + userId, cross-chat)
// ============================================
model UserProfile {
  id            String @id @default(cuid())
  userId        String
  orgId         String @default("default")
  agentConfigId String @default("") @map("agent_config_id")

  /// Free-form Markdown maintained by the compact engine and operators
  profile String @default("")

  /// Structured JSON sections derived from profile Markdown (see contract.ts: ProfileSections)
  sections String @default("{}")

  totalChats     Int       @default(0)
  totalCases     Int       @default(0)
  resolvedCases  Int       @default(0)
  escalatedCases Int       @default(0)
  lastCaseType   String?
  firstSeenAt    DateTime?
  lastSeenAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, agentConfigId, userId])
  @@index([orgId, agentConfigId])
  @@index([userId])
  @@map("user_profiles")
}

// ============================================
// 消息记录
// ============================================
model Message {
  id     String @id @default(cuid())
  caseId String
  orgId  String @default("default") @map("org_id")
  chatId String @default("")
  runId  String? @map("run_id")
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  role          String
  content       String
  contentBlocks Json?
  providerContent Json?
  providerMeta    Json?
  isStreaming   Boolean @default(false)
  streamId      String?

  createdAt DateTime @default(now())

  @@index([caseId])
  @@index([orgId, chatId])
  @@index([orgId, runId])
  @@map("messages")
}

// ============================================
// 操作追踪
// ============================================
model ActionTrace {
  id     String  @id @default(cuid())
  caseId String
  orgId  String  @default("default") @map("org_id")
  case   Case    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  chatId String?
  runId  String? @map("run_id")

  actionType String
  title      String
  detail     String?
  payload    String? // JSON

  createdAt DateTime @default(now())

  @@index([caseId])
  @@index([chatId])
  @@index([orgId, chatId])
  @@index([orgId, runId])
  @@map("action_traces")
}

// ============================================
// 知识检索 — 知识源配置（GPTBots / 外部 RAG）
// ============================================
model KnowledgeSource {
  id            String @id @default(cuid())
  agentConfigId String @map("agent_config_id")

  name        String // 显示名称
  description String?

  // GPTBots API 检索参数
  groupIds         String  @default("[]") // JSON: string[] — GPTBots 知识库 group_id
  dataIds          String? // JSON: string[] — 可选，限定文档范围
  embeddingRate    Float   @default(0.9)
  topK             Int     @default(5)
  rerankVersion    String? // "Jina-reranker-v2-base-multilingual" | "BGE-Rerank" | etc.
  docCorrelation   Float? // 相关性阈值 0.1-0.95
  modelControlTopK Boolean @default(false) // 是否允许模型自行控制 topK

  // 可选：关联到某个 caseType（如 deposit_issue）
  caseTypeTag String?

  enabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agentConfig AgentConfig @relation(fields: [agentConfigId], references: [id], onDelete: Cascade)

  @@unique([agentConfigId, name])
  @@index([agentConfigId, enabled])
  @@map("knowledge_sources")
}

// ============================================
// ExternalConversation — 第三方平台对话映射 (LiveChat/Intercom/Tawk)
// ============================================
model ExternalConversation {
  id             String   @id @default(cuid())
  orgId          String   @default("default") @map("org_id")
  platform       String // 'livechat' | 'intercom' | 'tawk'
  externalChatId String
  internalCaseId String?
  status         String   @default("active") // active|transferred|closed
  bridgeState    String   @default("idle") // idle|thinking|waiting_choice|waiting_form|transferred
  textBuffer     String   @default("")
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([platform, externalChatId])
  @@index([orgId, platform, status])
  @@map("external_conversations")
}

// ============================================
// 人工任务
// ============================================
model HumanTask {
  id     String @id @default(cuid())
  caseId String
  orgId  String @default("default") @map("org_id")
  chatId String @default("")
  runId  String? @map("run_id")
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  queue  String
  status String @default("pending")

  question        String
  fields          String? // JSON: array of {key, label, type, required?, options?} — structured form for human operator
  answers         String? // JSON: Record<string, string> — structured answers from operator
  verdict         String?
  expectedEta     String?
  notes           String?
  chatLog         String? // JSON: ConsultMsg[] — full consultation chat history (persisted for re-open)
  customerMessage String? // Plain-language resolution message for the customer (set on resolve)

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  notifiedAt DateTime?

  @@index([caseId])
  @@index([orgId, chatId])
  @@index([orgId, runId])
  @@map("human_tasks")
}

// ============================================
// Webhook Event — idempotency dedup (LiveChat / Slack / etc.)
// ============================================
model WebhookEvent {
  id          String   @id // external event id from webhook payload (e.g. LiveChat event.id)
  platform    String // 'livechat' | 'slack' | ...
  processedAt DateTime @default(now())

  @@index([platform, processedAt])
  @@map("webhook_events")
}

// ============================================
// LiveChat Pending Events — retry queue for failed bridge processing
// ============================================
model LiveChatPendingEvent {
  id          String   @id @default(cuid())
  chatId      String
  orgId       String   @default("default") @map("org_id")
  payload     Json
  attempt     Int      @default(0)
  lastError   String?
  nextRetryAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([nextRetryAt, attempt])
  @@map("livechat_pending_events")
}

// ============================================
// ChatSession — chat-level memory (cross-case)
// ============================================
model ChatSession {
  id             String   @id @default(cuid())
  chatId         String
  orgId          String   @default("default") @map("org_id")
  contextMap     String   @default("{}")
  summary        String?
  keyEvents      String   @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([orgId, chatId])
  @@map("chat_sessions")
}

// ============================================
// S5 — Channel Binding — per-agent channel config
// ============================================
model ChannelBinding {
  id                  String   @id @default(cuid())
  agentConfigId       String   @map("agent_config_id")
  channel             String // 'web-chat' | 'livechat' | 'slack' | 'discord' | 'whatsapp'
  enabled             Boolean  @default(false)
  credentials         String   @default("{}") // JSON — secrets/connection (LiveChatCredentials etc.)
  botAccessToken      String?  @map("bot_access_token") // denormalized from credentials for common queries
  licenseId           String?  @map("license_id") // denormalized from credentials for common queries
  toolOverrides       String? // JSON: Record<string, RenderHint>
  defaults            String? // JSON: { plain?, card?, form? }
  channelSkillBinding String? // JSON: string[] — historical allowlist of tool names
  /// Human Ops: escalation strategy per channel
  transferStrategy    String? // 'transfer_chat' | 'consult' | 'silent_task'
  transferTarget      String? // JSON: { type: 'group'|'agent'|'queue', ids: [...] }
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  agentConfig AgentConfig @relation(fields: [agentConfigId], references: [id], onDelete: Cascade)

  @@unique([agentConfigId, channel])
  @@map("channel_bindings")
}

// ============================================
// Pilot — durable operator cockpit state
// ============================================
model PilotSession {
  id             String  @id @default(cuid())
  orgId          String  @map("org_id")
  agentConfigId  String? @map("agent_config_id")
  agentFamilyKey String? @map("agent_family_key")
  bindingScope   String  @default("draft_agent") @map("binding_scope")

  createdByUserId         String    @map("created_by_user_id")
  activeEditorUserId      String?   @map("active_editor_user_id")
  status                  String    @default("in_progress")
  title                   String    @default("Pilot session")
  currentMode             String    @default("critique_existing_agent") @map("current_mode")
  summary                 Json?
  pinnedState             Json?     @map("pinned_state")
  currentBuildBriefId     String?   @map("current_build_brief_id")
  currentTodoPlanId       String?   @map("current_todo_plan_id")
  currentActiveTodoItemId String?   @map("current_active_todo_item_id")
  latestProposalId        String?   @map("latest_proposal_id")
  latestReceiptRunId      String?   @map("latest_receipt_run_id")
  latestHandoffId         String?   @map("latest_handoff_id")
  memoryDegraded          Boolean   @default(false) @map("memory_degraded")
  compactedAt             DateTime? @map("compacted_at")
  archivedAt              DateTime? @map("archived_at")
  isCurrent               Boolean   @default(true) @map("is_current")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages         PilotMessage[]
  proposals        PilotProposal[]
  todoPlans        PilotTodoPlan[]
  todoItems        PilotTodoItem[]
  handoffs         PilotHandoff[]
  buildBriefs      AgentBuildBrief[]
  inspectionTraces PilotInspectionTrace[]

  @@index([orgId, agentConfigId, isCurrent])
  @@index([orgId, agentFamilyKey, bindingScope, isCurrent])
  @@index([createdByUserId])
  @@map("pilot_sessions")
}

model PilotMessage {
  id        String @id @default(cuid())
  orgId     String @map("org_id")
  sessionId String @map("session_id")

  role              String
  kind              String   @default("message")
  content           String
  structuredPayload Json?    @map("structured_payload")
  createdByUserId   String?  @map("created_by_user_id")
  createdAt         DateTime @default(now())

  session PilotSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([orgId, sessionId, createdAt])
  @@map("pilot_messages")
}

model PilotProposal {
  id               String  @id @default(cuid())
  orgId            String  @map("org_id")
  sessionId        String  @map("session_id")
  todoItemId       String? @map("todo_item_id")
  parentProposalId String? @map("parent_proposal_id")

  status         String  @default("drafted")
  primarySurface String  @map("primary_surface")
  title          String
  summary        String
  intentSummary  String? @map("intent_summary")
  batchRationale String? @map("batch_rationale")
  blastRadius    String? @map("blast_radius")
  validationPlan Json?   @map("validation_plan")
  proposal       Json
  diffGroups     Json?   @map("diff_groups")
  patchCount     Int     @default(0) @map("patch_count")

  baseAgentConfigId         String    @map("base_agent_config_id")
  baseDraftFingerprint      String    @map("base_draft_fingerprint")
  acceptedByUserId          String?   @map("accepted_by_user_id")
  acceptedAt                DateTime? @map("accepted_at")
  appliedByUserId           String?   @map("applied_by_user_id")
  appliedAt                 DateTime? @map("applied_at")
  appliedDraftAgentConfigId String?   @map("applied_draft_agent_config_id")
  createdByUserId           String?   @map("created_by_user_id")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session  PilotSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  todoItem PilotTodoItem? @relation(fields: [todoItemId], references: [id], onDelete: SetNull)

  @@index([orgId, sessionId, createdAt])
  @@index([orgId, status])
  @@index([baseAgentConfigId])
  @@map("pilot_proposals")
}

model PilotTodoPlan {
  id        String @id @default(cuid())
  orgId     String @map("org_id")
  sessionId String @map("session_id")

  title           String?
  isCurrent       Boolean  @default(true) @map("is_current")
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  session PilotSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  items   PilotTodoItem[]

  @@index([orgId, sessionId, isCurrent])
  @@map("pilot_todo_plans")
}

model PilotTodoItem {
  id        String @id @default(cuid())
  orgId     String @map("org_id")
  sessionId String @map("session_id")
  planId    String @map("plan_id")

  type               String
  status             String   @default("pending")
  title              String
  description        String?
  isRequired         Boolean  @default(true) @map("is_required")
  visibleReason      String?  @map("visible_reason")
  latestProposalId   String?  @map("latest_proposal_id")
  latestReceiptRunId String?  @map("latest_receipt_run_id")
  latestHandoffId    String?  @map("latest_handoff_id")
  targetScenarioName String?  @map("target_scenario_name")
  metadata           Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  session   PilotSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  plan      PilotTodoPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  proposals PilotProposal[]

  @@index([orgId, sessionId, status])
  @@index([orgId, planId, status])
  @@map("pilot_todo_items")
}

model PilotHandoff {
  id        String @id @default(cuid())
  orgId     String @map("org_id")
  sessionId String @map("session_id")

  draftAgentConfigId    String   @map("draft_agent_config_id")
  draftFingerprint      String   @map("draft_fingerprint")
  handoffSummary        String   @map("handoff_summary")
  readinessVerdict      String   @default("not_ready") @map("readiness_verdict")
  blockers              Json?
  risks                 Json?
  referencedProposalIds Json?    @map("referenced_proposal_ids")
  referencedReceiptIds  Json?    @map("referenced_receipt_ids")
  coveredTodoItemIds    Json?    @map("covered_todo_item_ids")
  isCurrent             Boolean  @default(true) @map("is_current")
  createdByUserId       String?  @map("created_by_user_id")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  session PilotSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([orgId, sessionId, isCurrent])
  @@index([draftAgentConfigId])
  @@map("pilot_handoffs")
}

model AgentBuildBrief {
  id             String  @id @default(cuid())
  orgId          String  @map("org_id")
  agentFamilyKey String  @map("agent_family_key")
  sessionId      String? @map("session_id")

  revision                     Int       @default(1)
  status                       String    @default("draft")
  businessGoal                 String?   @map("business_goal")
  targetChannels               Json      @map("target_channels")
  supportedUseCases            Json      @map("supported_use_cases")
  outOfScopeUseCases           Json      @map("out_of_scope_use_cases")
  escalationPolicy             String?   @map("escalation_policy")
  requiredToolsAndIntegrations Json      @map("required_tools_and_integrations")
  toneAndResponseConstraints   Json      @map("tone_and_response_constraints")
  validationExpectations       Json      @map("validation_expectations")
  openQuestions                Json      @map("open_questions")
  isCurrent                    Boolean   @default(true) @map("is_current")
  confirmedAt                  DateTime? @map("confirmed_at")
  confirmedByUserId            String?   @map("confirmed_by_user_id")
  supersededAt                 DateTime? @map("superseded_at")
  supersededById               String?   @map("superseded_by_id")
  createdByUserId              String?   @map("created_by_user_id")
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  session         PilotSession?            @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  recommendations TemplateRecommendation[]
  tailoringPlans  TemplateTailoringPlan[]
  scratchPlans    ScratchBuildPlan[]

  @@index([orgId, agentFamilyKey, isCurrent])
  @@index([orgId, status])
  @@map("agent_build_briefs")
}

model TemplateRecommendation {
  id      String @id @default(cuid())
  orgId   String @map("org_id")
  briefId String @map("brief_id")

  candidateTemplates    Json      @map("candidate_templates")
  recommendedTemplateId String?   @map("recommended_template_id")
  fitSummary            String    @map("fit_summary")
  mismatchSummary       String?   @map("mismatch_summary")
  whyNotScratch         String?   @map("why_not_scratch")
  whyScratch            String?   @map("why_scratch")
  isCurrent             Boolean   @default(true) @map("is_current")
  supersededAt          DateTime? @map("superseded_at")
  supersededById        String?   @map("superseded_by_id")
  createdByUserId       String?   @map("created_by_user_id")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  brief          AgentBuildBrief         @relation(fields: [briefId], references: [id], onDelete: Cascade)
  tailoringPlans TemplateTailoringPlan[]

  @@index([orgId, briefId, isCurrent])
  @@map("template_recommendations")
}

model TemplateTailoringPlan {
  id               String  @id @default(cuid())
  orgId            String  @map("org_id")
  briefId          String  @map("brief_id")
  recommendationId String? @map("recommendation_id")

  selectedTemplateId         String    @map("selected_template_id")
  fitAreas                   Json      @map("fit_areas")
  mismatchAreas              Json      @map("mismatch_areas")
  requiredTailoringGroups    Json      @map("required_tailoring_groups")
  recommendedTailoringGroups Json      @map("recommended_tailoring_groups")
  firstValidationTargets     Json      @map("first_validation_targets")
  isCurrent                  Boolean   @default(true) @map("is_current")
  supersededAt               DateTime? @map("superseded_at")
  supersededById             String?   @map("superseded_by_id")
  createdByUserId            String?   @map("created_by_user_id")
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  brief          AgentBuildBrief         @relation(fields: [briefId], references: [id], onDelete: Cascade)
  recommendation TemplateRecommendation? @relation(fields: [recommendationId], references: [id], onDelete: SetNull)

  @@index([orgId, briefId, selectedTemplateId, isCurrent])
  @@map("template_tailoring_plans")
}

model ScratchBuildPlan {
  id      String @id @default(cuid())
  orgId   String @map("org_id")
  briefId String @map("brief_id")

  scratchScope               String    @default("default") @map("scratch_scope")
  proposedFoundationSurfaces Json      @map("proposed_foundation_surfaces")
  requiredBuildGroups        Json      @map("required_build_groups")
  recommendedBuildGroups     Json      @map("recommended_build_groups")
  initialToolingPlan         Json      @map("initial_tooling_plan")
  initialValidationTargets   Json      @map("initial_validation_targets")
  isCurrent                  Boolean   @default(true) @map("is_current")
  supersededAt               DateTime? @map("superseded_at")
  supersededById             String?   @map("superseded_by_id")
  createdByUserId            String?   @map("created_by_user_id")
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  brief AgentBuildBrief @relation(fields: [briefId], references: [id], onDelete: Cascade)

  @@index([orgId, briefId, scratchScope, isCurrent])
  @@map("scratch_build_plans")
}

model PilotInspectionTrace {
  id        String @id @default(cuid())
  orgId     String @map("org_id")
  sessionId String @map("session_id")

  actionClass        String   @map("action_class")
  targetObjectRef    Json?    @map("target_object_ref")
  steps              Json
  evidenceSufficient Boolean  @default(false) @map("evidence_sufficient")
  stopReason         String?  @map("stop_reason")
  createdByUserId    String?  @map("created_by_user_id")
  createdAt          DateTime @default(now())

  session PilotSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([orgId, sessionId, createdAt])
  @@map("pilot_inspection_traces")
}

// ============================================
// D1 — User identity
// ============================================
model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String?
  googleSub    String? @unique @map("google_sub")
  passwordHash String? @map("password_hash")

  memberships     Membership[]
  auditLogs       AuditLog[]   @relation("ActorAuditLogs")
  sentInvitations Invitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// ============================================
// D1 — Organization membership
// ============================================
model Membership {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  orgId      String    @map("org_id")
  role       String // owner|admin|operator|viewer
  invitedAt  DateTime  @default(now()) @map("invited_at")
  acceptedAt DateTime? @map("accepted_at")

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
  @@index([userId])
  @@map("memberships")
}

// ============================================
// D1 — Audit log
// ============================================
model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String   @map("actor_user_id")
  orgId       String   @map("org_id")
  action      String // e.g. "tool.create", "tool.update", "tool.delete"
  target      String // e.g. "tool:my_tool_name"
  before      Json? // snapshot before mutation
  after       Json? // snapshot after mutation
  createdAt   DateTime @default(now())

  actor User @relation("ActorAuditLogs", fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([actorUserId])
  @@index([orgId, createdAt])
  @@map("audit_logs")
}

// ============================================
// D1 — Invitation
// ============================================
model Invitation {
  id        String   @id @default(cuid())
  email     String? // null = share link (anyone can use); non-null = email-bound invite
  orgId     String   @map("org_id")
  invitedBy String   @map("invited_by")
  role      String   @default("viewer") // owner|admin|operator|viewer
  token     String   @unique
  state     String   @default("pending") // pending|accepted|expired
  maxUses   Int? // null = unlimited (only meaningful for share links)
  useCount  Int      @default(0)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now())

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  inviter User         @relation(fields: [invitedBy], references: [id], onDelete: Cascade)

  @@unique([email, orgId])
  @@index([token])
  @@index([orgId])
  @@map("invitations")
}
