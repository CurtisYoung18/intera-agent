// Intera Harness - Prisma Schema
// Agentic Customer Service Platform
//
// Table names use explicit @@map for PostgreSQL compatibility
// SQLite is the local dev database; production targets Neon PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// B 端客户（游戏供应商 / 商户）
// ============================================
model Customer {
  id        String   @id @default(cuid())
  name      String
  apiKey    String?
  password  String?  // bcrypt hash — null means no password needed for Console
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agentConfig           AgentConfig?
  caseTypes             CaseType[]
  skills                Skill[]
  policies              Policy[]
  routings              Routing[]
  cases                 Case[]
  knowledgeSources      KnowledgeSource[]
  externalConversations ExternalConversation[]

  @@map("customers")
}

// ============================================
// Agent 编排配置
// ============================================
model AgentConfig {
  id         String   @id @default(cuid())
  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  model          String  @default("claude-sonnet-4-20250514")
  temperature    Float   @default(0.5)
  thinkingBudget Int     @default(4096)
  maxIterations  Int     @default(20)
  systemPrompt   String
  showThinking   Boolean @default(false)

  maxOutputTokens       Int? // default 4096
  resumePrompt          String? // synthetic message for human task resume
  formResponseTemplate  String? // synthetic message for form submission
  humanSkills           String? // JSON array of skill names available to human operator during consultation
  consultationPrompt    String? // override for consultation system prompt (human-chat route)
  debugMode             Boolean @default(false) // write full API request/response to debug-logs/
  enableLlmSanitization Boolean @default(false) // LLM-based leaked context sanitization after each stream turn
  evaluationModel       String? // Model for stage transition evaluation

  /// Chat app only: DeepSeek beta chat + prefix row — customer **composer** drafting assist (not agent loop).
  prefixContinuationEnabled         Boolean @default(false)
  prefixContinuationChatModel       String? // e.g. deepseek-chat
  prefixContinuationBaseUrl         String? // e.g. https://api.deepseek.com/beta
  prefixContinuationAssistantPrefix String? // extra system notes for completion (accessibility / tone)
  prefixContinuationStop            String? // JSON string[] optional stop sequences
  /// Composer: min draft chars before continuation request (CJK-aware).
  prefixContinuationMinDraftChars   Int     @default(4)

  // JSON fields
  memoryStrategy     String  // MemoryStrategy
  policyHooks        String  // PolicyHooks
  knowledgeRetrieval String?  // KnowledgeRetrievalConfig (skeleton, awaiting embedding key)
  gptbotsApiKey      String?  // per-customer GPTBots API key (overrides GPTBOTS_API_KEY env var)
  invariantCheck     Boolean  @default(false) // S1 tool-result invariant assertion in dev/prod

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("agent_configs")
}

// ============================================
// Case 类型定义（动态状态机）
// ============================================
model CaseType {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  type        String
  displayName String
  description String?
  icon        String

  requiredFacts       String // JSON: string[]
  stages              String // JSON: string[] — 动态状态机
  stageConfigs        String? // JSON: Record<string, StageConfig> — per-stage config
  orchestratorConfig  String? // JSON: OrchestratorConfig — sub-agent dispatch rules
  defaultGoal         String
  escalateOn          String // JSON: string[]
  autoCloseConditions String? // JSON

  enabled Boolean @default(true) // false = excluded from routing / intent classification UI

  requireHumanReview Boolean @default(false) // true = finalize requires a resolved human task

  /// "stage" = predefined stage machine (default); "step" = engine-driven step executor
  executionMode   String  @default("stage")
  /// Natural-language Standard Operating Procedure — only used when executionMode = "cc"
  sop             String?
  /// Max auto-continuation turns in SOP mode (prevents infinite loops)
  sopMaxAutoTurns Int     @default(10)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([customerId, type])
  @@map("case_types")
}

// ============================================
// Skill 注册中心
// ============================================
model Skill {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  name        String
  description String

  inputSchema  String // JSON Schema
  outputSchema String // JSON Schema

  mode       String  @default("mock") // "mock" | "http"
  endpoint   String?
  httpMethod String  @default("POST")
  headers    String? // JSON
  timeoutMs  Int     @default(8000)

  mockFixture String? // JSON — [MOCK] mock 默认样本
  displayVerb String? // JSON {"text":"...","icon":"..."} — customer-visible spinner label

  guardPhase        String  @default("post") // "pre" | "post"
  isConcurrencySafe Boolean @default(true)
  enabled           Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([customerId, name])
  @@map("skills")
}

// ============================================
// Policy 规则配置
// ============================================
model Policy {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  name        String
  description String?
  hook        String // "preTool" | "postTool" | "preFinalize"
  rule        String // JSON: PolicyRule
  enabled     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([customerId, name])
  @@map("policies")
}

// ============================================
// 人工路由配置
// ============================================
model Routing {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  queue          String
  description    String?
  skillsAllowed  String // JSON: string[]
  priority       Int     @default(0)
  autoAssign     Boolean @default(true)
  maxWaitingTime Int     @default(300)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([customerId, queue])
  @@map("routings")
}

// ============================================
// Case（工单）
// ============================================
model Case {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  userId     String
  /// Groups all cases that belong to the same chat session.
  /// Generated once per page-load by the frontend and forwarded with every message.
  chatId     String?

  type    String
  status  String  @default("created")
  goal    String?
  blocker String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?

  memory     CaseMemory?
  messages   Message[]
  traces     ActionTrace[]
  humanTasks HumanTask[]

  @@index([chatId])
  @@map("cases")
}

// ============================================
// Case Memory
// ============================================
model CaseMemory {
  id     String @id @default(cuid())
  caseId String @unique
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  confirmedFacts    String    @default("{}") // JSON
  missingFacts      String    @default("[]") // JSON
  skillsCalled      String    @default("[]") // JSON
  skillResults      String    @default("{}") // JSON
  keyEvents         String    @default("[]") // JSON
  humanTaskStatus   String    @default("none")
  needsContinuation Boolean   @default(false)
  continuationLock  DateTime?
  summary           String?
  /// JSON: TodoItem[] — SOP mode todo list, shared between Core Agent and sub-agents
  todos             String?
  /// JSON: Record<string, TodoItem[]> — per-agent todo lists for shared dashboard isolation
  agentTodos        String?
  /// Increments on every dashboard write; sub-agents use this to detect changes
  dashboardVersion  Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("case_memories")
}

// ============================================
// 消息记录
// ============================================
model Message {
  id     String @id @default(cuid())
  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  role          String
  content       String
  contentBlocks Json?
  isStreaming   Boolean @default(false)
  streamId      String?

  createdAt DateTime @default(now())

  @@index([caseId])
  @@map("messages")
}

// ============================================
// 操作追踪
// ============================================
model ActionTrace {
  id     String @id @default(cuid())
  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  chatId String?

  actionType String
  title      String
  detail     String?
  payload    String? // JSON

  createdAt DateTime @default(now())

  @@index([caseId])
  @@index([chatId])
  @@map("action_traces")
}

// ============================================
// 知识检索 — 知识源配置（GPTBots / 外部 RAG）
// ============================================
model KnowledgeSource {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  name        String // 显示名称
  description String?

  // GPTBots API 检索参数
  groupIds       String  @default("[]") // JSON: string[] — GPTBots 知识库 group_id
  dataIds        String? // JSON: string[] — 可选，限定文档范围
  embeddingRate  Float   @default(0.9)
  topK           Int     @default(5)
  rerankVersion  String? // "Jina-reranker-v2-base-multilingual" | "BGE-Rerank" | etc.
  docCorrelation Float? // 相关性阈值 0.1-0.95

  // 可选：关联到某个 caseType（如 deposit_issue）
  caseTypeTag String?

  enabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([customerId, name])
  @@index([customerId, enabled])
  @@map("knowledge_sources")
}

// ============================================
// ExternalConversation — 第三方平台对话映射 (LiveChat/Intercom/Tawk)
// ============================================
model ExternalConversation {
  id             String   @id @default(cuid())
  customerId     String
  platform       String   // 'livechat' | 'intercom' | 'tawk'
  externalChatId String
  internalCaseId String?
  status         String   @default("active") // active|transferred|closed
  bridgeState    String   @default("idle")   // idle|thinking|waiting_choice|waiting_form|transferred
  textBuffer     String   @default("")
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  customer       Customer @relation(fields: [customerId], references: [id])

  @@unique([platform, externalChatId])
  @@index([customerId, platform, status])
  @@map("external_conversations")
}

// ============================================
// 人工任务
// ============================================
model HumanTask {
  id     String @id @default(cuid())
  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  queue  String
  status String @default("pending")

  question        String
  fields          String? // JSON: array of {key, label, type, required?, options?} — structured form for human operator
  answers         String? // JSON: Record<string, string> — structured answers from operator
  verdict         String?
  expectedEta     String?
  notes           String?
  chatLog         String? // JSON: ConsultMsg[] — full consultation chat history (persisted for re-open)
  customerMessage String? // Plain-language resolution message for the customer (set on resolve)

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  notifiedAt DateTime?

  @@index([caseId])
  @@map("human_tasks")
}

// ============================================
// LiveChat Bridge — 集成配置
// ============================================
model LiveChatConfig {
  id              String   @id @default(cuid())
  customerId      String   @unique
  botAccessToken  String
  licenseId       String
  webhookSecret   String?
  showSkillStatus Boolean  @default(true)
  enabled         Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("livechat_configs")
}

// ============================================
// Webhook Event — idempotency dedup (LiveChat / Slack / etc.)
// ============================================
model WebhookEvent {
  id          String   @id // external event id from webhook payload (e.g. LiveChat event.id)
  platform    String   // 'livechat' | 'slack' | ...
  processedAt DateTime @default(now())

  @@index([platform, processedAt])
  @@map("webhook_events")
}

// ============================================
// LiveChat Pending Events — retry queue for failed bridge processing
// ============================================
model LiveChatPendingEvent {
  id          String   @id @default(cuid())
  chatId      String
  customerId  String
  payload     Json
  attempt     Int      @default(0)
  lastError   String?
  nextRetryAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([nextRetryAt, attempt])
  @@map("livechat_pending_events")
}

// ============================================
// Channel Health — per-customer channel status monitoring
// ============================================
model ChannelHealth {
  id          String   @id @default(cuid())
  customerId  String
  channel     String
  status      String   @default("healthy")
  lastChecked DateTime @default(now())
  lastError   String?
  metadata    Json?

  @@unique([customerId, channel])
  @@map("channel_health")
}

// ============================================
// S5 — Channel Binding — per-customer channel config
// ============================================
model ChannelBinding {
  id                  String   @id @default(cuid())
  customerId          String
  channel             String   // 'web-chat' | 'livechat' | 'slack' | 'discord' | 'whatsapp'
  enabled             Boolean  @default(false)
  credentials         String   @default("{}") // JSON
  toolOverrides       String?  // JSON: Record<string, RenderHint>
  defaults            String?  // JSON: { plain?, card?, form? }
  channelSkillBinding String?  // JSON: string[] — allowlist of tool names
  /// Human Ops: escalation strategy per channel
  transferStrategy    String?  // 'transfer_chat' | 'consult' | 'silent_task'
  transferTarget      String?  // JSON: { type: 'group'|'agent'|'queue', ids: [...] }
  consultationPrompt  String?  // System prompt override for human consultation
  humanSkills         String?  // JSON: string[] — skills available during consultation
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([customerId, channel])
  @@map("channel_bindings")
}
