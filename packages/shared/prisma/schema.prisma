// Intera Harness - Prisma Schema
// Agentic Customer Service Platform
//
// Table names use explicit @@map for PostgreSQL compatibility.
// Local dev uses a Dockerized Postgres 16 (docker compose up -d postgres → host port 5434);
// production is the self-hosted Ubuntu Postgres. The legacy SQLite dev shim is retired
// (the postgresql datasource cannot use a file: URL). See doc/to-do/2026-06-08-foundation-safe-local-db.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// B 端商户（游戏供应商 / 商户）
// ============================================
model Organization {
  id        String   @id @default(cuid())
  name      String
  apiKey    String?
  password  String? // bcrypt hash — null means no password needed for Console
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  invitations Invitation[]

  @@map("organizations")
}

// ============================================
// API Key — per-org authentication keys
// ============================================
model ApiKey {
  id            String    @id @default(cuid())
  orgId         String    @map("org_id")
  name          String // "production" | "staging" | 渠道名
  prefix        String // 明文前 8 位，便于 UI 识别，如 "intera_sk_live_a1b2"
  hash          String    @unique // sha256(fullKey)
  agentConfigId String?   @map("agent_config_id") // 绑定到具体 AgentConfig；null = org 默认
  lastUsedAt    DateTime? @map("last_used_at")
  revokedAt     DateTime? @map("revoked_at")
  createdAt     DateTime  @default(now())

  @@index([orgId])
  @@index([orgId, agentConfigId])
  @@map("api_keys")
}

// ============================================
// Agent 编排配置
// ============================================
model AgentConfig {
  id    String @id @default(cuid())
  orgId String @map("org_id")
  name  String @default("Default")

  /// Version number — multiple rows per (orgId, name) form a linear version history.
  /// The row where isActive = true is the one runtime traffic uses.
  version  Int     @default(1)
  /// Points to the row this version was forked from. Null for v1 (root).
  parentId String?
  /// Exactly one row per (orgId, name) has isActive = true.
  /// Enforced in app code via atomic transactions on /activate.
  isActive Boolean @default(true)

  parent   AgentConfig?  @relation("AgentVersions", fields: [parentId], references: [id], onDelete: SetNull)
  children AgentConfig[] @relation("AgentVersions")

  // Agent-scoped sub-modules
  tools            Tool[]
  hooks            Hook[]
  caseTypes        CaseType[]
  knowledgeSources KnowledgeSource[]
  channelBindings  ChannelBinding[]

  model            String
  temperature      Float   @default(0.5)
  thinkingBudget   Int     @default(4096)
  maxIterations    Int     @default(20)
  coreSystemPrompt String? // Core/discovery prompt (no active case); falls back to CORE_SYSTEM_PROMPT default when empty
  extendedThinking Boolean @default(false) @map("showThinking")

  maxOutputTokens Int? // default 4096
  resumePrompt    String? // synthetic message for human task resume

  // JSON fields
  memoryStrategy String // MemoryStrategy
  gptbotsApiKey  String? // per-org GPTBots API key (overrides GPTBOTS_API_KEY env var)

  /// Version release note — set when a version is published/activated
  releaseNote String?   @map("release_note")
  /// When this version was published (made active)
  publishedAt DateTime? @map("published_at")
  /// User ID of who published this version
  publishedBy String?   @map("published_by")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, name, version])
  @@index([orgId])
  @@index([orgId, name, isActive])
  @@map("agent_configs")
}

// ============================================
// Case 类型定义（Procedure target）
// ============================================
model CaseType {
  id            String @id @default(cuid())
  agentConfigId String @map("agent_config_id")

  type        String
  displayName String
  description String?
  icon        String

  requiredFacts       String  // JSON: string[]
  defaultGoal         String
  escalateOn          String  // JSON: string[]
  autoCloseConditions String? // JSON

  enabled Boolean @default(true) // false = excluded from routing / intent classification UI

  /// JSON: Procedure (ordered ProcedureStep[]). When present, the case runs the single-agent Procedure path.
  procedure    String?
  /// Safety bound on auto-continuation turns.
  maxAutoTurns Int     @default(10)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agentConfig AgentConfig @relation(fields: [agentConfigId], references: [id], onDelete: Cascade)

  @@unique([agentConfigId, type])
  @@map("case_types")
}

// ============================================
// Tool 注册中心
// ============================================
model Tool {
  id            String @id @default(cuid())
  agentConfigId String @map("agent_config_id")

  name        String
  description String

  inputSchema  String // JSON Schema
  outputSchema String // JSON Schema

  mode       String  @default("static_fixture")
  endpoint   String?
  httpMethod String  @default("POST")
  headers    String? // JSON
  timeoutMs  Int     @default(8000)

  mockFixture String? // JSON — [MOCK] mock 默认样本
  displayVerb String? // JSON {"text":"...","icon":"..."} — customer-visible spinner label
  renderHints String? // JSON: { livechat?: LivechatRenderHint, "web-chat"?: RenderHint }

  guardPhase        String  @default("post") // "pre" | "post"
  toolCategory      String? // "system_info" | "operational" | null
  isConcurrencySafe Boolean @default(true)
  enabled           Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agentConfig AgentConfig @relation(fields: [agentConfigId], references: [id], onDelete: Cascade)

  @@unique([agentConfigId, name])
  @@map("tools")
}

// ============================================
// Hook control layer
// ============================================
model Hook {
  id            String @id @default(cuid())
  agentConfigId String @map("agent_config_id")

  name        String
  displayName String?
  description String?

  checkpoint  String // PreToolUse | PostToolUse | Stop
  handlerKind String // declarative | code | http
  handler     String // JSON: HookHandler
  enabled     Boolean @default(true)
  severity    String  @default("medium") // low | medium | high | critical

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agentConfig AgentConfig   @relation(fields: [agentConfigId], references: [id], onDelete: Cascade)
  bindings    HookBinding[]

  @@unique([agentConfigId, name])
  @@index([agentConfigId, checkpoint])
  @@map("hooks")
}

model HookBinding {
  id            String @id @default(cuid())
  agentConfigId String @map("agent_config_id")
  hookId        String @map("hook_id")

  scopeType String // agent | caseType | procedureStep | tool
  scopeKey  String // agent | caseType:<id> | procedureStep:<caseTypeId>:<stepId> | tool:<id>

  caseTypeId      String? @map("case_type_id")
  procedureStepId String? @map("procedure_step_id")
  toolId          String? @map("tool_id")

  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hook Hook @relation(fields: [hookId], references: [id], onDelete: Cascade)

  @@unique([agentConfigId, hookId, scopeKey])
  @@index([agentConfigId, scopeType])
  @@index([agentConfigId, scopeKey])
  @@map("hook_bindings")
}

// ============================================
// Case（工单）
// ============================================
model Case {
  id     String @id @default(cuid())
  orgId  String @default("default") @map("org_id")
  userId String
  /// Groups all cases that belong to the same chat session.
  /// Generated once per page-load by the frontend and forwarded with every message.
  chatId String

  type    String
  status  String  @default("created")
  source  String  @default("live")
  goal    String?
  blocker String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?

  memory     ChatMemory?
  messages   Message[]
  traces     ActionTrace[]
  humanTasks HumanTask[]

  @@index([chatId])
  @@map("cases")
}

// ============================================
// Chat Memory — per-case working memory (facts, tool results, todos, compact summary).
// Cross-session accumulation lives in UserProfile (user_profiles table).
// ============================================
model ChatMemory {
  id     String @id @default(cuid())
  caseId String @unique
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  confirmedFacts    String    @default("{}") // JSON
  missingFacts      String    @default("[]") // JSON
  toolsCalled       String    @default("[]") // JSON
  toolResults       String    @default("{}") // JSON
  keyEvents         String    @default("[]") // JSON
  humanTaskStatus   String    @default("none")
  summary           String?
  /// JSON: TodoItem[] — Procedure todo list for the Case Owner Agent
  todos             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("chat_memories")
}

// ============================================
// User Profile — AI-maintained Markdown user portrait (per userId, cross-chat)
// ============================================
model UserProfile {
  id     String @id @default(cuid())
  userId String @unique
  orgId  String @default("default")

  /// Free-form Markdown maintained by the compact engine and operators
  profile String @default("")

  /// Structured JSON sections derived from profile Markdown (see contract.ts: ProfileSections)
  sections String @default("{}")

  totalChats     Int       @default(0)
  totalCases     Int       @default(0)
  resolvedCases  Int       @default(0)
  escalatedCases Int       @default(0)
  lastCaseType   String?
  firstSeenAt    DateTime?
  lastSeenAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_profiles")
}

// ============================================
// 消息记录
// ============================================
model Message {
  id     String @id @default(cuid())
  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  role          String
  content       String
  contentBlocks Json?
  isStreaming   Boolean @default(false)
  streamId      String?

  createdAt DateTime @default(now())

  @@index([caseId])
  @@map("messages")
}

// ============================================
// 操作追踪
// ============================================
model ActionTrace {
  id     String  @id @default(cuid())
  caseId String
  case   Case    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  chatId String?

  actionType String
  title      String
  detail     String?
  payload    String? // JSON

  createdAt DateTime @default(now())

  @@index([caseId])
  @@index([chatId])
  @@map("action_traces")
}

// ============================================
// 知识检索 — 知识源配置（GPTBots / 外部 RAG）
// ============================================
model KnowledgeSource {
  id            String @id @default(cuid())
  agentConfigId String @map("agent_config_id")

  name        String // 显示名称
  description String?

  // GPTBots API 检索参数
  groupIds         String  @default("[]") // JSON: string[] — GPTBots 知识库 group_id
  dataIds          String? // JSON: string[] — 可选，限定文档范围
  embeddingRate    Float   @default(0.9)
  topK             Int     @default(5)
  rerankVersion    String? // "Jina-reranker-v2-base-multilingual" | "BGE-Rerank" | etc.
  docCorrelation   Float? // 相关性阈值 0.1-0.95
  modelControlTopK Boolean @default(false) // 是否允许模型自行控制 topK

  // 可选：关联到某个 caseType（如 deposit_issue）
  caseTypeTag String?

  enabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agentConfig AgentConfig @relation(fields: [agentConfigId], references: [id], onDelete: Cascade)

  @@unique([agentConfigId, name])
  @@index([agentConfigId, enabled])
  @@map("knowledge_sources")
}

// ============================================
// ExternalConversation — 第三方平台对话映射 (LiveChat/Intercom/Tawk)
// ============================================
model ExternalConversation {
  id             String   @id @default(cuid())
  orgId          String   @default("default") @map("org_id")
  platform       String // 'livechat' | 'intercom' | 'tawk'
  externalChatId String
  internalCaseId String?
  status         String   @default("active") // active|transferred|closed
  bridgeState    String   @default("idle") // idle|thinking|waiting_choice|waiting_form|transferred
  textBuffer     String   @default("")
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([platform, externalChatId])
  @@index([orgId, platform, status])
  @@map("external_conversations")
}

// ============================================
// 人工任务
// ============================================
model HumanTask {
  id     String @id @default(cuid())
  caseId String
  case   Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)

  queue  String
  status String @default("pending")

  question        String
  fields          String? // JSON: array of {key, label, type, required?, options?} — structured form for human operator
  answers         String? // JSON: Record<string, string> — structured answers from operator
  verdict         String?
  expectedEta     String?
  notes           String?
  chatLog         String? // JSON: ConsultMsg[] — full consultation chat history (persisted for re-open)
  customerMessage String? // Plain-language resolution message for the customer (set on resolve)

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  notifiedAt DateTime?

  @@index([caseId])
  @@map("human_tasks")
}

// ============================================
// Webhook Event — idempotency dedup (LiveChat / Slack / etc.)
// ============================================
model WebhookEvent {
  id          String   @id // external event id from webhook payload (e.g. LiveChat event.id)
  platform    String // 'livechat' | 'slack' | ...
  processedAt DateTime @default(now())

  @@index([platform, processedAt])
  @@map("webhook_events")
}

// ============================================
// LiveChat Pending Events — retry queue for failed bridge processing
// ============================================
model LiveChatPendingEvent {
  id          String   @id @default(cuid())
  chatId      String
  orgId       String   @default("default") @map("org_id")
  payload     Json
  attempt     Int      @default(0)
  lastError   String?
  nextRetryAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([nextRetryAt, attempt])
  @@map("livechat_pending_events")
}

// ============================================
// ChatSession — chat-level memory (cross-case)
// ============================================
model ChatSession {
  id             String   @id @default(cuid())
  chatId         String   @unique
  orgId          String   @default("default") @map("org_id")
  confirmedFacts String   @default("{}")
  summary        String?
  keyEvents      String   @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("chat_sessions")
}

// ============================================
// S5 — Channel Binding — per-agent channel config
// ============================================
model ChannelBinding {
  id                  String   @id @default(cuid())
  agentConfigId       String   @map("agent_config_id")
  channel             String // 'web-chat' | 'livechat' | 'slack' | 'discord' | 'whatsapp'
  enabled             Boolean  @default(false)
  credentials         String   @default("{}") // JSON — secrets/connection (LiveChatCredentials etc.)
  botAccessToken      String?  @map("bot_access_token") // denormalized from credentials for common queries
  licenseId           String?  @map("license_id") // denormalized from credentials for common queries
  toolOverrides       String? // JSON: Record<string, RenderHint>
  defaults            String? // JSON: { plain?, card?, form? }
  channelSkillBinding String? // JSON: string[] — historical allowlist of tool names
  /// Human Ops: escalation strategy per channel
  transferStrategy    String? // 'transfer_chat' | 'consult' | 'silent_task'
  transferTarget      String? // JSON: { type: 'group'|'agent'|'queue', ids: [...] }
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  agentConfig AgentConfig @relation(fields: [agentConfigId], references: [id], onDelete: Cascade)

  @@unique([agentConfigId, channel])
  @@map("channel_bindings")
}

// ============================================
// D1 — User identity
// ============================================
model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String?
  googleSub    String? @unique @map("google_sub")
  passwordHash String? @map("password_hash")

  memberships     Membership[]
  auditLogs       AuditLog[]   @relation("ActorAuditLogs")
  sentInvitations Invitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// ============================================
// D1 — Organization membership
// ============================================
model Membership {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  orgId      String    @map("org_id")
  role       String // owner|admin|operator|viewer
  invitedAt  DateTime  @default(now()) @map("invited_at")
  acceptedAt DateTime? @map("accepted_at")

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
  @@index([userId])
  @@map("memberships")
}

// ============================================
// D1 — Audit log
// ============================================
model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String   @map("actor_user_id")
  orgId       String   @map("org_id")
  action      String // e.g. "tool.create", "tool.update", "tool.delete"
  target      String // e.g. "tool:my_tool_name"
  before      Json? // snapshot before mutation
  after       Json? // snapshot after mutation
  createdAt   DateTime @default(now())

  actor User @relation("ActorAuditLogs", fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([actorUserId])
  @@index([orgId, createdAt])
  @@map("audit_logs")
}

// ============================================
// D1 — Invitation
// ============================================
model Invitation {
  id        String   @id @default(cuid())
  email     String? // null = share link (anyone can use); non-null = email-bound invite
  orgId     String   @map("org_id")
  invitedBy String   @map("invited_by")
  role      String   @default("viewer") // owner|admin|operator|viewer
  token     String   @unique
  state     String   @default("pending") // pending|accepted|expired
  maxUses   Int? // null = unlimited (only meaningful for share links)
  useCount  Int      @default(0)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now())

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  inviter User         @relation(fields: [invitedBy], references: [id], onDelete: Cascade)

  @@unique([email, orgId])
  @@index([token])
  @@index([orgId])
  @@map("invitations")
}
